# Valores del modo manual. Docker Compose usa archivos generados por scripts/gestionar_secretos.py.
# No publiques credenciales reales.
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB=bd_weirdstyle
JWT_SECRET=replace-with-at-least-32-random-characters
PAYMENT_WEBHOOK_SECRET=replace-with-a-different-random-secret
ORDERS_INVENTORY_TOKEN=replace-with-orders-inventory-secret
ORDERS_PAYMENTS_TOKEN=replace-with-orders-payments-secret
PAYMENTS_ORDERS_TOKEN=replace-with-payments-orders-secret
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CLIENTS_URL=http://clients:8000
INVENTORY_URL=http://inventory:8000
ORDERS_URL=http://orders:8000
PAYMENTS_URL=http://payments:8000
NODE_ENV=development
